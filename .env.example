# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase (publishable key is safe for browsers; never use the service role here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# AI (server-only; no automatic fallback)
AI_DEFAULT_PROVIDER=groq
AI_DEFAULT_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
# CV scanning and extraction require local Unix sockets. See CV_SECURITY.md.
# Without these services, app uploads and/or extraction fail closed.
CV_SCANNER_SOCKET=
CV_PARSER_SOCKET=
# Server-side ingestion, billing and readiness only
SUPABASE_SERVICE_ROLE_KEY=
# Optional per-task overrides: AI_CV_PROVIDER, AI_CV_MODEL, AI_COVER_LETTER_PROVIDER,
# AI_COVER_LETTER_MODEL, AI_EXTRACTION_PROVIDER, AI_EXTRACTION_MODEL,
# AI_MATCHING_PROVIDER, AI_MATCHING_MODEL, AI_EMAIL_PROVIDER, AI_EMAIL_MODEL,
# AI_INTERVIEW_PROVIDER, AI_INTERVIEW_MODEL. These tasks are not all implemented.
# Stripe (server-only). Configure at least one recurring price and the webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=
STRIPE_ULTIMATE_MONTHLY_PRICE_ID=
STRIPE_ULTIMATE_ANNUAL_PRICE_ID=
# Optional: require an active/trialing configured paid subscription for AI generation.
BILLING_ENFORCE_AI=false
# Comma-separated authenticated Supabase user UUIDs allowed to view readiness.
INTEGRATION_ADMIN_USER_IDS=
# Optional Google OAuth connections (separate from GOOGLE_API_KEY for AI).
# Register /api/integrations/google/callback and configure restricted scopes and consent.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate a unique random 32-byte value encoded as base64; store only in a secret manager.
INTEGRATION_ENCRYPTION_KEY=
# Google metadata and calendar scopes may require consent verification/security review.
# Optional Microsoft Graph OAuth connections (register the callback URL separately).
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Staging-only account deletion. Keep false until live security and recovery tests pass.
ACCOUNT_DELETION_ENABLED=false
